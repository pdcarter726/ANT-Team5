{
  "name": "Game (WASD)",
  "description": "Head turns hold W/A/S/D, jaw clench is the left mouse button (hold to keep firing), double blink right-clicks, eyebrow raise opens the quick bar. Uses DirectInput keys, which most games need.",
  "cursor_speed": 250,
  "cursor_max_speed": 1400,
  "cursor_accel_s": 1.2,
  "hold_s": 0.4,
  "click_lookback_s": 0.3,
  "freeze_gaze_s": 0.0,
  "key_backend": "directinput",
  "gestures": {
    "head_turn_up": "hold:w",
    "head_turn_down": "hold:s",
    "head_turn_left": "hold:a",
    "head_turn_right": "hold:d",
    "eyebrow_raise": "menu",
    "jaw_clench": "mouse:left",
    "double_blink": "click:right",
    "left_wink": "none",
    "right_wink": "none"
  },
  "menu": [
    {"label": "Escape", "action": "key:esc"},
    {"label": "Jump", "action": "key:space"},
    {"label": "Use (E)", "action": "key:e"},
    {"label": "Inventory (I)", "action": "key:i"},
    {"label": "Map (M)", "action": "key:m"},
    {"label": "Enter", "action": "key:enter"},
    {"label": "Pause controller", "action": "controller:pause"}
  ]
}
